# ==========================================
# CampusKhoj (IIIT Allahabad) Environment Config
# ==========================================

# Port for backend Express server
PORT=5050

# MongoDB Atlas connection string (or local MongoDB URI)
# If left blank, CampusKhoj automatically starts an embedded In-Memory MongoDB server for instant zero-setup development!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campuskhoj?retryWrites=true&w=majority

# JWT Authentication Secret and Token Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production_2024
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configuration for Uploaded Photos
# If left blank, CampusKhoj automatically saves images to local disk storage (server/uploads/)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed College Domain for Student Email Verification
ALLOWED_EMAIL_DOMAIN=iiita.ac.in
ENFORCE_EMAIL_DOMAIN=true
